+    mined = {}
+    if master.exists():
+        try:
+            mined = json.loads(master.read_text(encoding="utf-8"))
+        except Exception:
+            pass
+    return {"ts": _now(), "mistake_counts": scars, "history_keys": list(mined.keys()) if mined else []}
